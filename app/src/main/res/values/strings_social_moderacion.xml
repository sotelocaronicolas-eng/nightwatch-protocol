    <string name="social_block_done_close">Listo</string>

    <!-- Personas bloqueadas -->
    <string name="social_blocked_link">🚫 Personas bloqueadas</string>
    <string name="social_blocked_title">Personas bloqueadas</string>
    <string name="social_blocked_intro">Ninguno de los dos puede buscar, invitar ni retar al otro. Al desbloquear no se recupera la amistad ni la racha en pareja.</string>

    <string name="social_block_cancel">Cancelar</string>
    <string name="social_block_done_title">Persona bloqueada</string>
    <string name="social_block_done_body">Bloqueaste a %1$s. Puedes desbloquear desde Amigos > Personas bloqueadas.</string>
    <string name="social_block_done_close">Listo</string>


    <!-- ============================== Report and block (module 4, script 0011) ============================== -->

    <!-- Error: the server does not have the new actions yet -->
    <string name="social_error_unavailable">Feature not available right now.</string>

    <!-- Report and block links -->
    <string name="social_report_link">Report</string>
    <string name="social_block_link">Block</string>
    <string name="social_report_link_desc">Report %1$s</string>
    <string name="social_block_link_desc">Block %1$s</string>

    <!-- Report -->
    <string name="social_report_title">Report %1$s</string>
    <string name="social_report_intro">Choose the reason. The NightWatch team will review the report; the reported person won\'t know who sent it.</string>
    <string name="social_report_reason_inappropriate_photo">Inappropriate photo</string>
    <string name="social_report_reason_offensive_name">Offensive username</string>
    <string name="social_report_reason_harassment">Harassment or bad behavior</string>
    <string name="social_report_reason_other">Other reason</string>
    <string name="social_report_note_label">Note (optional)</string>
    <string name="social_report_note_counter">%1$d/%2$d</string>
    <string name="social_report_send">Send report</string>
    <string name="social_report_sending">Sending…</string>
    <string name="social_report_cancel">Cancel</string>
    <string name="social_report_done_title">Report sent</string>
    <string name="social_report_done_body">Thank you. The team will review it. Reporting doesn\'t block %1$s: if you want to stop interacting with that person, you can also block them.</string>
    <string name="social_report_done_close">Done</string>

    <!-- Block (confirmation) -->
    <string name="social_block_title">Block %1$s?</string>
    <string name="social_block_body">You will stop being friends, your pair streak will end and pending challenges will be canceled. Neither of you will be able to search for, invite or challenge the other. If a battle is in progress, it does not end. You can unblock from Friends > Blocked people.</string>
    <string name="social_block_confirm">Block</string>
    <string name="social_block_blocking">Blocking…</string>
    <string name="social_block_cancel">Cancel</string>
    <string name="social_block_done_title">Person blocked</string>
    <string name="social_block_done_body">You blocked %1$s. You can unblock from Friends > Blocked people.</string>
    <string name="social_block_done_close">Done</string>

    <!-- Blocked people -->
    <string name="social_blocked_link">🚫 Blocked people</string>
    <string name="social_blocked_title">Blocked people</string>
    <string name="social_blocked_intro">Neither of you can search for, invite or challenge the other. Unblocking does not restore the friendship or the pair streak.</string>
    <string name="social_blocked_empty">You haven\'t blocked anyone.</string>
    <string name="social_blocked_unblock">Unblock</string>


    <string name="auth_recovery_title">Password Recovery</string>
    <string name="auth_recovery_intro">To recover your password, enter your email address. You will receive a 6-digit verification code to continue the process.</string>
    <string name="auth_recovery_email_not_found">Email not found</string>
    <string name="auth_new_password_title">New Password</string>

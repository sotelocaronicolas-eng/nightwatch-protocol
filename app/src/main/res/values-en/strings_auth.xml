<?xml version="1.0" encoding="utf-8"?>
<!--
    English of strings_auth.xml (Module 5, Stage 8): sign in, sign up, password recovery and new password. Prefix auth_.
    Same keys as res/values/strings_auth.xml; the Spanish file is the golden reference. American English.
-->
<resources>
    <!-- Shared by sign in, sign up and recovery -->
    <string name="auth_password_label">Password</string>
    <string name="auth_google_account_hint">This account was created with Google. Use \"Continue with Google\"</string>
    <string name="auth_error_no_google_account">Add a Google account to your phone to continue</string>
    <string name="auth_error_dialog_network">No internet connection. Check your connection and try again.</string>

    <!-- Sign in -->
    <string name="auth_login_error_title">Sign-in error</string>
    <string name="auth_login_error_unknown">An unexpected error occurred. Try signing in again.</string>
    <string name="auth_login_username_label">Username/Email</string>
    <string name="auth_login_enter_email">Enter your email</string>
    <string name="auth_login_enter_password">Enter your password</string>
    <string name="auth_login_forgot_password">Forgot your password?</string>
    <string name="auth_login_keep_session">Keep me signed in</string>
    <string name="auth_login_button">SIGN IN</string>
    <string name="auth_login_or">OR</string>

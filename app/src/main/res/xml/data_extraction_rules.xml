<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de extracción de datos (Android 12+). La app guarda datos personales
   (género, fecha de nacimiento, caché del avatar) y un deviceId local que no debe
   restaurarse en otro teléfono, así que no se respalda ni se transfiere nada.
   Ver https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

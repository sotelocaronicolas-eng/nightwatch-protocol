<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de respaldo para Android 11 o menos (se ignoran desde Android 12; ver
   data_extraction_rules.xml). No se respalda nada: la app guarda datos personales
   y un deviceId local que no debe restaurarse en otro teléfono.
   Ver https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
